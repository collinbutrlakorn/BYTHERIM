rules_version = '2';
// Paste into Firebase console > Firestore Database > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/config/admins)
        && request.auth.token.email.lower() in get(/databases/$(database)/documents/config/admins).data.emails;
    }

    // Each person's saves and draft boards: theirs alone.
    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // The official universe and the site's own content (home page hero,
    // pinned posts): everyone reads, admins publish.
    match /official/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Usage counts (see Cloud.countPage in rp/js/cloud.js): one document
    // of daily totals per day, which any visitor's browser adds to and only
    // admins can read. Only the expected fields, all numbers or maps of
    // numbers, and nothing deleted.
    match /usage/{day} {
      allow read: if isAdmin();
      allow create, update: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['views', 'visitors', 'newVisitors', 'signedIn', 'mobile', 'desktop', 'refs', 'events', 'updated'])
        && (!('views' in request.resource.data) || request.resource.data.views.size() < 200)
        && (!('refs' in request.resource.data) || request.resource.data.refs.size() < 300)
        && (!('events' in request.resource.data) || request.resource.data.events.size() < 100);
      allow delete: if isAdmin();
    }

    // "Rate the sim" ratings (assets/rate.js): anyone adds one short
    // rating, nothing identifies the rater, and only admins read them.
    match /feedback/{id} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['stars', 'note', 'page', 'day', 'at'])
        && request.resource.data.stars is int && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
        && request.resource.data.note is string && request.resource.data.note.size() <= 500
        && request.resource.data.page is string && request.resource.data.page.size() <= 40
        && request.resource.data.day is string && request.resource.data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.at is number;
    }

    // The admin list: only admins can see or change it (anyone else's
    // check simply fails, which the site reads as "not an admin"). The
    // first admin is added by hand in the Firebase console.
    match /config/admins {
      allow read, write: if isAdmin();
    }
  }
}
